# TruthGuard-Chronos Backend Environment Variables

# Gemini API Keys with Automatic Failover Rotation
# If Key 1 fails or hits rate/quota limits (429), Key 2 is automatically triggered.
# If Key 2 exceeds its limit, Key 3 is triggered.
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here

# Alternative single-variable comma-separated format (optional):
# GEMINI_API_KEYS=key1,key2,key3

# Default lightweight model (optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
